# /etc/embedded-health/server.env -- read by the systemd unit.

# SQLite state file.  StateDirectory=embedded-health creates /var/lib/embedded-health
# owned by the service user, so this path needs no extra setup.
EH_DB_PATH=/var/lib/embedded-health/nodes.db

# Cadence the agents are told to use.  Changing it here and restarting the
# service re-times the whole fleet -- agents adopt it from the heartbeat reply.
EH_HEARTBEAT_INTERVAL=60

# Liveness thresholds, in multiples of the interval above.
# Amber once 2 beats are missed, red once 4 are.  4x60s = 4 minutes of silence
# before a node is called unreachable, which tolerates a DHCP renew or a brief
# switch reconvergence without crying wolf.
EH_LATE_AFTER_BEATS=2
EH_OFFLINE_AFTER_BEATS=4

# After this long with no contact a node is shown as "stale" -- almost certainly
# decommissioned rather than merely down.
EH_STALE_AFTER_HOURS=24

# Guard rails.
EH_MAX_BODY_BYTES=4096
EH_MAX_NODES=2000

PYTHONUNBUFFERED=1
